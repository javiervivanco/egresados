title "Egresados — Vista de Contenedores (C2)"

// ─── Personas (actores externos) ──────────────────────────────────────
(person)familia "Familia" {
    descr "Madre, padre o tutor de un egresado. Descubre planes, vota fechas y rankea planes 1-3."
}

(person)empresa-admin "Admin de Empresa" {
    descr "Operador de una empresa de viajes. Carga destinos/planes/documentos, propone fechas, registra ventas."
}

(person)super-admin "Super Admin" {
    descr "Dueño del marketplace. Carga catálogos, crea admins, audita comisiones."
}

// ─── Sistema bajo diseño: Containers ──────────────────────────────────
(enterprise-boundary)egresados "Egresados" {

    // ── Aplicaciones cliente (Vite SPAs) ──────────────────────────────
    (container)web-public "Frontend público" "React 18 + Vite + Tailwind + shadcn/ui" {
        descr "SPA de familias. Compara cards de planes, wizard de descubrimiento, vota fechas (MeetingDateVoting), rankea planes 1-3 (QuickVote), mensajería con empresa (Messaging). Port 5173."
        tags "cliente" "spa"
    }

    (container)web-admin "Admin SPA" "Refine + AntD + Vite" {
        descr "SPA de gestión. CRUD de catálogos (escuelas/grupos/empresas/destinos/planes/documentos), propuestas de reunión (FechasReunionSection), ventas (VentasSection), mensajería (AdminMessaging), dashboard de comisiones (SuperVentas). Port 5174."
        tags "cliente" "spa" "admin"
    }

    // ── Backend Supabase (servicios independientes) ───────────────────
    (container)auth "Auth" "GoTrue (Supabase)" {
        descr "Anonymous sign-in para familias (signInAnonymously). Email/password para admins (signInWithPassword). Emite JWT. Tabla profiles vincula user_id con rol (super_admin | empresa_admin | familia) y entidad relacionada (empresa_id o familia_id)."
    }

    (container-db)db "PostgreSQL" "Postgres 15 + RLS" {
        descr "Fuente de verdad. Tablas: escuelas, grupos (con `invitacion_token` + `invitacion_expira_at`, migration 0013), familias, alumnos, familia_miembros, empresas, destinos, planes_viaje (con `origen_ciudad_id`, migration 0015), documentos, fechas_reunion, votos_fecha, votos_plan, mensajes, ventas, profiles, leads, lead_actividades, eventos_anon, correcciones, ciudades, empresas_origenes + las legacy `planes`/`votos`. RLS activo en todas las tablas con helpers is_super_admin()/is_empresa_admin()/current_familia_id()/current_familia_in_grupo()."
        tags "datos" "core"
    }

    (container)storage "Object Storage" "S3-compatible (Supabase)" {
        descr "Bucket privado `documentos` para PDFs/planillas de planes. RLS vía policies + signed URLs. Solo empresa-admin dueña y super-admin pueden leer; empresa-admin dueña puede escribir."
        tags "datos"
    }

    (container)edge-fns "Edge Functions" "Deno (Supabase)" {
        descr "Runtime para funciones serverless. Hoy vacío. Va a alojar el handler de documentos (insert en `documentos` → descarga PDF → LLM/OCR → datos_extraidos). Mock client-side ocupa su rol hasta que se implemente."
        tags "compute" "futuro"
    }

    // ── Relaciones internas entre containers ─────────────────────────
    web-public to db "Lee planes_viaje/destinos/empresas, escribe votos_fecha/votos_plan/votos" "REST/PostgREST + anon JWT"
    web-public to auth "signInAnonymously, lee perfil (familia_id)" "HTTPS"
    web-public to storage "Lee PDFs públicos de planes" "HTTPS"
    web-admin to db "CRUD catálogos, propuestas de reunión, ventas, mensajes, leads" "REST/PostgREST + admin JWT"
    web-admin to auth "signInWithPassword, lee perfil (rol + empresa_id)" "HTTPS"
    web-admin to storage "Sube documentos, lee con policies" "HTTPS"
    web-admin to edge-fns "Trigger `procesar-documento` desde upload" "HTTPS (futuro)"
    edge-fns to storage "Descarga PDF recién subido" "HTTPS"
    edge-fns to db "Lee `documentos`, escribe `datos_extraidos` + transición procesado_estado" "REST"
    auth to db "Persiste `auth.users`, valida JWT en cada request" "interno"
}

// ─── Relaciones externas (personas + sistemas externos) ───────────────
// Familias
familia to web-public "Navega, vota, chatea" "HTTPS"
familia to auth "Sign-in anónimo y persistencia de sesión" "HTTPS"

// Empresa-admin
empresa-admin to web-admin "Gestiona su empresa" "HTTPS"
empresa-admin to auth "Sign-in con email/password" "HTTPS"

// Super-admin
super-admin to web-admin "Configura plataforma y audita" "HTTPS"
super-admin to auth "Sign-in con email/password" "HTTPS"

// Sistema egress con infra externa de Supabase
egresados to supabase-storage-ext "Usa buckets como dependencia desplegada" "managed infra"

(system-ext)supabase-storage-ext "Supabase Storage (infra externa)" {
    descr "Managed storage de Supabase. Se modela como system-ext en C1 porque es un servicio de terceros; en C2 los containers de egress lo usan como dependencia."
}