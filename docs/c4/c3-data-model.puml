@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml
LAYOUT_WITH_LEGEND()
title "Egresados — Modelo de Datos (C3 del container PostgreSQL)"
Person("familia", "Familia", $descr="Identidad persistida vía `signInAnonymously` + tabla `profiles` (rol=familia, familia_id).")
Person("empresa_admin", "Admin de Empresa", $descr="Identidad persistida vía `signInWithPassword` + tabla `profiles` (rol=empresa_admin, empresa_id).")
Person("super_admin", "Super Admin", $descr="Único rol con bypass de RLS (is_super_admin() = true). Único que puede mover ventas a pagada/liquidada.")
Container_Boundary("db", "PostgreSQL — modelo de datos") {
Boundary("nucleo", "Núcleo de identidad y catálogos") {
Component("identidad", "Identidad", "profiles + helpers RLS", $descr="Tabla `profiles`: vincula `auth.users` (Supabase Auth) con `rol` ∈ {super_admin, empresa_admin, familia} y entidad relacionada (`empresa_id` o `familia_id`). Habilita que las policies RLS lean el rol sin re-lookup. Anonymous sign-in de familias crea un profile con rol=familia en el mismo flow que el INSERT en `familias` (migration 0017).")
ComponentDb("clientes", "Clientes", "escuelas/grupos/familias/alumnos/familia_miembros", $descr="Jerarquía de unidades familiares: escuelas → grupos (año/grado) → familias → alumnos. Soporta onboarding via IdentityGate (escuela → grupo → apellido). La tabla `escuelas` tiene columna `estado` ∈ {activa, pendiente, archivada} para auto-creación desde onboarding (migration 0008). `grupos` tiene `invitacion_token` + `invitacion_expira_at` (90 días, migration 0013). `familia_miembros` permite múltiples alumnos por familia.")
ComponentDb("oferta", "Oferta", "empresas/destinos/planes_viaje/documentos", $descr="Jerarquía de planes: empresas → destinos → planes_viaje. `documentos` referencia el bucket privado `documentos` de Supabase Storage (FK lógica por path). `empresas.comision_pct_default` (default 8%) alimenta las ventas via trigger (migration 0003). `planes_viaje.origen_ciudad_id` (migration 0015) habilita matching plan-by-plan.")
ComponentDb("geo", "Geo / Matching", "ciudades/empresas_origenes", $descr="Datos geográficos. `ciudades` indexada por escuelas y planes_viaje. `empresas_origenes` lista ciudades de salida por empresa (un plan sin `origen_ciudad_id` hereda los orígenes de su empresa). Soporta el wizard geográfico del frontend público y el matching oferta↔grupo del admin.")
}
Boundary("funnel", "Etapas del funnel de venta") {
ComponentDb("votacion_fechas", "Votación de fechas", "fechas_reunion/votos_fecha", $descr="Etapa 1. Empresa-admin propone `fechas_reunion` a un grupo. Familias del grupo votan sí/no en `votos_fecha` (`MeetingDateVoting`). La fecha confirmada se usa para coordinar la reunión presencial/virtual antes de la votación de planes.")
ComponentDb("votacion_planes", "Votación de planes", "votos_plan", $descr="Etapa 2. Familias rankean `planes_viaje` con prioridad ∈ {1, 2, 3}. `unique (familia_id, prioridad)` evita duplicados por slot. Triggered por `QuickVote`. Eventualmente `VotingResults` va a leer de acá joined con `familias → grupos → escuelas`.")
ComponentDb("mensajeria", "Mensajería", "mensajes", $descr="Hilos empresa↔grupo. Un hilo existe si la empresa propuso fecha (`fechas_reunion`) o si hubo conversación (`mensajes`). `contenido` es inmutable (audit trail). Badges de no-leídos vía `leido_empresa`/`leido_grupo`. `autor_rol` valida que empresa_admin del mensaje sea de la `empresa_id` correcta, y que familia sea del `grupo_id` correcto.")
ComponentDb("ventas", "Ventas y comisiones", "ventas", $descr="Cierre del funnel. `monto_total` y `comision_monto` son generated columns. `comision_pct` se setea via trigger desde `empresas.comision_pct_default` si no se pasa explícito. Estados: borrador → confirmada → pagada → liquidada + cancelada (timestamps estampados por trigger). `unique index` parcial `(grupo_id) WHERE estado ∈ activa` impide que un grupo quede cerrado con dos empresas.")
}
Boundary("growth", "Crecimiento y soporte") {
ComponentDb("crm", "CRM de leads", "leads/lead_actividades", $descr="Leads pre-identidad (familia aún no registrada). `lead_actividades` registra interacciones. Conversión a familia via RPC `lead_to_familia` (migration 0018) — wrapper de `familia_unirse` (0014) + `lead_upsert` (0006/0010) + trigger `leads_track_conversion` (0007). Captura UTM y datos de origen del tráfico.")
ComponentDb("marketing", "Marketing / Atribución", "eventos_anon", $descr="Eventos anónimos para entender el funnel discovery→registro. Permite atribuir conversiones a campañas sin necesidad de auth. Alimenta el dashboard de conversión y la decisión de inversión en ads.")
ComponentDb("correcciones", "Correcciones reportadas", "correcciones", $descr="Reportes de usuarios sobre errores en cualquier entidad (planes con precio mal cargado, destinos con datos erróneos, etc). Triage del super-admin o del empresa-admin dueño. Sin SLA formal, capturado para revisión manual.")
ComponentDb("legacy", "Espejos legacy", "planes/votos", $descr="Tablas planas (`planes`, `votos`) que mirrorean los datos JSON originales pre-multi-tenant. No se insertan filas nuevas. `votos` sigue siendo la fuente de `VotingResults` hasta migrar a `votos_plan` joinado con familias. `planes` es histórico. Eventual deprecación.")
}
Component("rls_helpers", "RLS helpers", "Funciones SQL SECURITY DEFINER", $descr="Funciones de soporte para Row Level Security. `is_super_admin()`, `is_empresa_admin(empresa_id)`, `current_familia_id()`, `current_familia_in_grupo(grupo_id)`. Aplicadas en policies de TODAS las tablas mutables (escuelas, empresas, ventas, mensajes, etc). Sin esto el multi-tenancy se rompe — son la pieza crítica de seguridad.")
Rel("identidad", "clientes", "profiles.familia_id referencia familias.id")
Rel("identidad", "oferta", "profiles.empresa_id referencia empresas.id")
Rel("clientes", "votacion_fechas", "fechas_reunion.grupo_id → grupos.id")
Rel("clientes", "votacion_planes", "votos_plan.familia_id → familias.id")
Rel("clientes", "mensajeria", "mensajes.grupo_id → grupos.id")
Rel("crm", "clientes", "leads → familia via RPC de conversión")
Rel("oferta", "geo", "planes_viaje.origen_ciudad_id → ciudades.id")
Rel("oferta", "votacion_fechas", "fechas_reunion.empresa_id → empresas.id")
Rel("oferta", "votacion_planes", "votos_plan.plan_id → planes_viaje.id")
Rel("oferta", "ventas", "ventas.plan_id → planes_viaje.id")
Rel("oferta", "mensajeria", "mensajes.empresa_id → empresas.id")
Rel("geo", "clientes", "escuelas.ciudad_id → ciudades.id")
Rel("legacy", "oferta", "planes (mirror) refleja planes_viaje")
Rel("legacy", "votacion_planes", "votos (mirror) duplica votos_plan")
Rel("rls_helpers", "identidad", "Lee profiles del JWT para resolver rol")
Rel("rls_helpers", "clientes", "current_familia_in_grupo() valida membresía")
Rel("rls_helpers", "oferta", "is_empresa_admin(empresa_id) autoriza UPDATE")
Rel("rls_helpers", "ventas", "Único rol super_admin puede mover a pagada/liquidada")
}
Rel("familia", "clientes", "INSERT/UPDATE en su propia fila de familia + RLS")
Rel("familia", "votacion_fechas", "INSERT en votos_fecha del grupo al que pertenece")
Rel("familia", "votacion_planes", "UPSERT en votos_plan(familia_id, prioridad)")
Rel("familia", "mensajeria", "INSERT mensajes del grupo, autor_rol=familia")
Rel("familia", "correcciones", "INSERT reportes sin restricción")
Rel("empresa_admin", "oferta", "INSERT/UPDATE destinos/planes_viaje/documentos de su empresa")
Rel("empresa_admin", "votacion_fechas", "INSERT fechas_reunion proponiendo al grupo")
Rel("empresa_admin", "mensajeria", "INSERT mensajes del hilo, autor_rol=empresa")
Rel("empresa_admin", "ventas", "INSERT/UPDATE ventas en borrador/confirmada")
Rel("empresa_admin", "correcciones", "UPDATE triage de su empresa")
Rel("super_admin", "identidad", "INSERT/UPDATE profiles de admins")
Rel("super_admin", "clientes", "INSERT/UPDATE escuelas/grupos/familias")
Rel("super_admin", "oferta", "INSERT/UPDATE catálogos base")
Rel("super_admin", "geo", "INSERT/UPDATE ciudades y matching")
Rel("super_admin", "ventas", "Único que UPDATE a pagada/liquidada")
Rel("super_admin", "crm", "SELECT dashboard agregado")
Rel("super_admin", "marketing", "SELECT métricas de atribución")
Rel("super_admin", "legacy", "SELECT — sin INSERT nuevos")
Rel("super_admin", "correcciones", "UPDATE triage final")
@enduml
